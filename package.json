{
  "name": "dsh-opencode-go-usage",
  "version": "2.0.1",
  "description": "DSH (DeepSeek Harness) plugin: an OpenCode GO monthly usage meter beside the composer context ring, a 5h ring around the send button, and a usage panel with a refresh-interval slider. Adapted from Tsunamistr/dsh-opencode-go-usage for DSH 0.2.x.",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "opencode",
    "opencode-go",
    "usage",
    "quota",
    "widget"
  ],
  "type": "module",
  "main": "./index.js",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lx000166/dsh-opencode-go-usage.git"
  },
  "homepage": "https://github.com/lx000166/dsh-opencode-go-usage#readme",
  "bugs": {
    "url": "https://github.com/lx000166/dsh-opencode-go-usage/issues"
  }
}
